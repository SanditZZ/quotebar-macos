<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sparkle's configuration, and nothing else.

  The rest of the Info.plist is still generated by Xcode from the
  INFOPLIST_KEY_* build settings and merged into this file at build time.
  These keys need a real file because they are not Apple-defined, and their
  values are not all strings — SUScheduledCheckInterval in particular has to
  be an integer, which the build-setting route cannot express.
-->
<plist version="1.0">
<dict>
	<!-- The appcast, served from GitHub Pages. It stays a 404 until a gh-pages
	     branch exists and the release workflow has published a feed to it;
	     until then a background check simply finds nothing, and UpdateService
	     reports that plainly rather than as an error the user can act on. -->
	<key>SUFeedURL</key>
	<string>https://sanditzz.github.io/quotebar-macos/appcast.xml</string>

	<!-- The public half of QuoteBar's own EdDSA key pair — deliberately not
	     the one idle-tapper-macos uses. This, not Apple notarization, is what
	     makes an update trustworthy: Sparkle refuses any archive whose
	     signature does not verify against this key. The private half lives in
	     the login keychain under the "QuoteBar" account and in the
	     SPARKLE_PRIVATE_KEY repository secret, and must never enter the
	     repository. -->
	<key>SUPublicEDKey</key>
	<string>FjIyvQn7hAk+LBXwcBpghFLlKcjGwESh4FNH3l6lb8w=</string>

	<!-- Check daily, in the background, on by default. The user can turn this
	     off in Settings; doing so writes SUEnableAutomaticChecks to defaults,
	     which then takes precedence over this initial value. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>

	<!-- Permit downloading and installing an update without a second prompt
	     once the user has agreed to automatic updates. -->
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
</dict>
</plist>
